# Public API base URL inlined into the client bundle (Next.js).
# Leave empty to use the relative "/api" path (works with the next.config.mjs
# rewrite to a local backend in dev).
NEXT_PUBLIC_API_URL=https://api-supervisor.bsvibe.dev/api

# Server-only: target backend for the /api/:path* rewrite in next.config.mjs.
# Used by `next dev` and `next start` when running locally.
API_PROXY_TARGET=http://localhost:8000
