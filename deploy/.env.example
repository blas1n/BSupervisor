POSTGRES_PASSWORD=change-me
BSVIBE_AUTH_URL=https://auth.bsvibe.dev

# ── Token introspection (RFC 7662) ─────────────────────────────
# REQUIRED in prod — without these three, the service can only
# verify user JWTs (not opaque ``bsv_sk_*`` PATs and not the HS256
# PAT JWTs the device-flow grant emits). Phase 8 dogfood (2026-05-11)
# caught four products silently 401'ing because these were never set.
#
# 1. Provision a row in BSVibe-Auth's ``oauth_clients`` for this
#    backend (e.g. ``bsupervisor-prod`` confidential client). The raw
#    secret is shown once at creation; store it in Vaultwarden.
# 2. Set the three vars below from that row.
#
# Both ``UNPREFIXED`` and ``BSV_PREFIXED`` names work (Wave 3 added
# AliasChoices in bsupervisor/config.py).
INTROSPECTION_URL=https://auth.bsvibe.dev/api/tokens/introspect
INTROSPECTION_CLIENT_ID=bsupervisor-prod
INTROSPECTION_CLIENT_SECRET=<64-hex-from-oauth_clients-issue>

# Optional — emergency bootstrap admin token's SHA-256. Prod normally
# leaves this unset; introspection covers all real traffic.
# BOOTSTRAP_TOKEN_HASH=<sha256-of-bsv_admin_*>

DAILY_COST_THRESHOLD_USD=50.00

# Encryption key for stored credentials. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be unique per environment. Rotating it invalidates previously stored secrets.
ENCRYPTION_KEY=

# Per-source rate limit for POST /api/events (60s window, fail-closed).
EVENTS_RATE_LIMIT_PER_MINUTE=600

# Production CORS allowed origins (comma-separated).
CORS_ALLOWED_ORIGINS=https://supervisor.bsvibe.dev

# Daily budget displayed on the costs dashboard (Audit §M17).
DAILY_BUDGET_USD=100.00

# DB connection pool sizing (Audit §M20). pool_recycle is in seconds.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
