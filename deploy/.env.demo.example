# BSupervisor DEMO environment template (deploy/.env.demo).
#
# Copy to `deploy/.env.demo` and fill in real values. `.env.demo` is gitignored.
# This file configures the PUBLIC INTERACTIVE DEMO stack — separate from prod.
#
# Generate secrets:
#   openssl rand -hex 32      # for DEMO_JWT_SECRET
#   openssl rand -base64 32   # for POSTGRES_PASSWORD

# ─── Demo session signing (per-product, NOT shared with prod auth.bsvibe.dev) ───
DEMO_JWT_SECRET=

# ─── Database (isolated demo PG) ───
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://bsupervisor_demo:${POSTGRES_PASSWORD}@postgres:5432/bsupervisor_demo

# ─── Server ───
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Auth (demo backend uses DEMO_JWT_SECRET, not BSVibe auth) ───
AUTH_PROVIDER=local
BSVIBE_AUTH_URL=https://auth.bsvibe.dev

# ─── Cost alerts (demo — informational only, no real budget) ───
DAILY_COST_THRESHOLD_USD=50.00

# ─── No external webhooks in demo ───
WEBHOOK_URL=

# ─── CORS — demo frontend domain only ───
CORS_ORIGINS=https://demo-supervisor.bsvibe.dev

# ─── Logging ───
LOG_LEVEL=INFO
