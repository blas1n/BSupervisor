# Database
DATABASE_URL=postgresql+asyncpg://bsupervisor:bsupervisor_dev@postgres:5432/bsupervisor

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Auth (bsvibe-auth)
AUTH_PROVIDER=local
BSVIBE_AUTH_URL=https://auth.bsvibe.dev

# Cost alerts
DAILY_COST_THRESHOLD_USD=50.00

# Webhook (optional)
WEBHOOK_URL=

# Encryption — used to encrypt stored credentials (integration api keys,
# telegram tokens, slack webhook URLs) at rest. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be set to a non-default value in production. Rotating this key
# invalidates previously stored secrets.
ENCRYPTION_KEY=

# Rate limit for POST /api/events — per source bucket per 60s window.
# Fail-closed (429 returned when exceeded; no DB / rule-engine work happens).
EVENTS_RATE_LIMIT_PER_MINUTE=600

# Production CORS — comma-separated origins. Defaults to localhost in dev.
# Example: CORS_ALLOWED_ORIGINS=https://supervisor.bsvibe.dev
CORS_ALLOWED_ORIGINS=http://localhost:3500
