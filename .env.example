# Database
DATABASE_URL=postgresql+asyncpg://bsupervisor:bsupervisor_dev@postgres:5432/bsupervisor

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Auth (bsvibe-auth — legacy single-tenant shim, retained for the
# transition period; bsvibe-authz takes over JWT/permission checks below)
AUTH_PROVIDER=local
BSVIBE_AUTH_URL=https://auth.bsvibe.dev

# bsvibe-authz (Phase 0 P0.5) — shared OpenFGA + service-JWT verifier.
# OpenFGA store + model id come from `_infra/openfga/...` after applying
# `packages/bsvibe-authz/schema/bsvibe.fga`.
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_ID=
OPENFGA_AUTH_MODEL_ID=
OPENFGA_AUTH_TOKEN=
# HS256 secret shared with BSVibe-Auth /api/service-tokens/issue. Phase
# 0.4-후속 swaps this to Ed25519. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_TOKEN_SIGNING_SECRET=
# User session JWT verification (Phase 0 = HS256 shared with BSVibe-Auth).
USER_JWT_SECRET=
USER_JWT_ALGORITHM=HS256
USER_JWT_AUDIENCE=bsvibe
USER_JWT_ISSUER=https://auth.bsvibe.dev
PERMISSION_CACHE_TTL_S=30

# Cost alerts
DAILY_COST_THRESHOLD_USD=50.00

# Daily budget shown on the costs dashboard. Was previously hardcoded to $100
# inside the route handler (Audit §M17).
DAILY_BUDGET_USD=100.00

# Webhook (optional)
WEBHOOK_URL=

# Encryption — used to encrypt stored credentials (integration api keys,
# telegram tokens, slack webhook URLs) at rest. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# MUST be set to a non-default value in production. Rotating this key
# invalidates previously stored secrets.
ENCRYPTION_KEY=

# Rate limit for POST /api/events — per source bucket per 60s window.
# Fail-closed (429 returned when exceeded; no DB / rule-engine work happens).
EVENTS_RATE_LIMIT_PER_MINUTE=600

# Production CORS — comma-separated origins. Defaults to localhost in dev.
# Example: CORS_ALLOWED_ORIGINS=https://supervisor.bsvibe.dev
CORS_ALLOWED_ORIGINS=http://localhost:3500

# DB connection pool sizing (Audit §M20). SQLAlchemy defaults are
# pool_size=5 / max_overflow=10, which is easy to exhaust when the daily
# reporter runs alongside dashboard polling. ``pool_recycle`` is in seconds.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Phase Audit Batch 2 — bsvibe-audit OutboxRelay configuration. Empty
# audit URL keeps the relay disabled (events still queue locally in the
# ``audit_outbox`` table). Production sets these to the BSVibe-Auth
# audit ingestion endpoint + a service token from
# ``POST /api/service-tokens/issue`` (aud="bsvibe-auth", scope="audit.write").
BSVIBE_AUTH_AUDIT_URL=
BSVIBE_AUTH_AUDIT_SERVICE_TOKEN=
AUDIT_BATCH_SIZE=50
AUDIT_RELAY_INTERVAL_S=5.0
AUDIT_MAX_RETRIES=5
